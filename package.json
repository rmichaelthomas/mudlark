{
  "name": "mudlark",
  "version": "1.0.0",
  "description": "Mudlark replays how a built artifact came to be, reconstructed from git commits.",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "mudlark": "tsx src/cli.ts",
    "capture": "tsx src/capture/capture.ts",
    "delta": "tsx src/delta/build.ts",
    "verify": "tsx scripts/verify-capture-playback.ts",
    "verify:player": "tsx scripts/verify-player.ts",
    "verify:grammar": "tsx scripts/verify-grammar.ts",
    "record-demo": "tsx scripts/record-demo.ts",
    "dev": "vite"
  },
  "keywords": [
    "git",
    "visual",
    "replay",
    "commits",
    "dom",
    "capture",
    "playback",
    "layers",
    "developer-tools",
    "visualization"
  ],
  "author": "R. Michael Thomas (https://onesurface.org)",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "ajv": "^8.20.0",
    "ajv-cli": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "bin": {
    "mudlark": "./src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rmichaelthomas/mudlark.git"
  },
  "homepage": "https://github.com/rmichaelthomas/mudlark",
  "bugs": {
    "url": "https://github.com/rmichaelthomas/mudlark/issues"
  }
}
